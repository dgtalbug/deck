# Allowlist mode: ignore everything at the repo root except what's listed below.
# Track source, tests, assets, manifests, and explicitly allowed public docs.
# Local planning, generated files, and editor/agent state stay local.
# Ignore rules do not untrack files already committed; use git rm --cached.
/*

# Tracked
!/.gitignore
!/src/
!/tests/
!/scripts/
!/public/
!/package.json
!/tsconfig.json
!/bunfig.toml
!/.oxlintrc.json
!/drizzle.config.ts
!/drizzle/
!/bun.lockb
!/bun.lock
!/LICENSE
!/README.md
!/CHANGELOG.md
!/docs/
/docs/*
!/docs/testing.md

# Build & runtime artifacts (also ignored inside tracked dirs)
node_modules/
dist/
/deck
/deck.exe
src/server/ui-assets.ts
src/core/board/migrations.ts
build/
coverage/
.deck/
*.sqlite
*.sqlite-wal
*.sqlite-shm
.env
.env.*
.DS_Store
*.log
.deck/board.sqlite
.deck/board.sqlite-wal
.deck/board.sqlite-shm

# Local planning only (including completed and archived changes)
/openspec/
/specs/
